{
  "id": "horloge",
  "title": "Horloge",
  "description": "Horloge numerique ou analogique, centree et redimensionnable, avec reglages via le menu Options (Start).",
  "iconId": "date_time",
  "size": 1,
  "settings": [
    {
      "id": "mode",
      "title": "Type d'horloge",
      "type": "choice",
      "options": [
        { "value": "digital", "label": "Numerique" },
        { "value": "analog", "label": "Analogique" }
      ],
      "default": "digital"
    },
    {
      "id": "format",
      "title": "Format (numerique)",
      "type": "choice",
      "options": [
        { "value": "24", "label": "24h" },
        { "value": "12", "label": "12h" }
      ],
      "default": "24"
    },
    {
      "id": "dial",
      "title": "Cadran (analogique)",
      "type": "choice",
      "options": [
        { "value": "simple", "label": "Simple" },
        { "value": "graduated", "label": "Gradue" },
        { "value": "numbers", "label": "Chiffres" }
      ],
      "default": "graduated"
    },
    {
      "id": "seconds",
      "title": "Afficher les secondes",
      "type": "toggle",
      "default": true
    }
  ]
}
